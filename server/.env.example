# MongoDB connection for the Mailroom app only.
# Uses a dedicated database name so other apps (e.g. PeoplesNote) stay untouched.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mailroom

# Use a port different from PeoplesNote (for example 3002).
PORT=3002

# Comma-separated list of allowed frontend origins for CORS + cookies.
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign/verify session integrity helpers.
SESSION_SECRET=replace-with-a-long-random-secret

# Session lifetime in milliseconds (default: 7 days).
SESSION_TTL_MS=604800000

# Cookie settings
COOKIE_NAME=mailroom_session
COOKIE_SECURE=false

# Resend (https://resend.com/docs/send-with-nodejs)
# Create an API key in the Resend dashboard and store it here — never in frontend code.
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender address (or "Name <email@your-verified-domain.com>").
# With an unverified account, Resend only allows sending to your own account email
# and may require using their test sender. Verify your domain at https://resend.com/domains.
RESEND_FROM_EMAIL=Mailroom <onboarding@resend.dev>
